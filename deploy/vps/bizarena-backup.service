[Unit]
Description=Biz Arena SQLite backup
After=bizarena.service

[Service]
Type=oneshot
User=bizarena
WorkingDirectory=/opt/bizarena
EnvironmentFile=/etc/bizarena/bizarena.env
ExecStart=/usr/bin/node /opt/bizarena/scripts/admin-storage.js backup
ExecStartPost=/usr/bin/find /var/lib/bizarena/backups -type f -name "biz-arena-*.sqlite" -mtime +14 -delete
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bizarena
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bizarena-backup
